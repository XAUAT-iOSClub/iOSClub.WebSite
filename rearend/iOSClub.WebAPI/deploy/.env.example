# 留空时使用持久化 SQLite；生产环境建议填写 PostgreSQL 连接字符串。
SQL=
REDIS=

# Compose 默认通过私有网络调用同一项目中的 finance-ocr 容器。
# 取消注释可配置外部 OCR 地址，赋空值可禁用 OCR。
# Finance__OcrEndpoint=http://finance-ocr:5099/ocr
# Finance__RecognitionTimeoutSeconds=60

# 可选：将新上传的发票图片保存到私有 S3 兼容存储桶。
# S3_ENABLED=true
# S3_BUCKET=finance
# S3_REGION=us-east-1
# 自定义 S3 API 地址。AWS S3 可留空，MinIO 可填 http://minio:9000。
# S3_ENDPOINT=
# MinIO 等要求路径式寻址的服务可设为 true。腾讯云 COS 使用 false。
# S3_FORCE_PATH_STYLE=false
# S3_BASE_PREFIX=finance
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# 可选：需要验证后端 Bearer Token 的私有 HTTPS CDN。
# S3_CDN_URL=
# S3_CDN_AUTH_TOKEN=

# 默认在确认发票前要求上传税务平台查验结果 PDF。
# FINANCE_VERIFICATION_REQUIRED=true

# JWT 与管理端密钥等生产配置，请按需补充。
JWT_ISSUER=iOS Club of XAUAT
JWT_AUDIENCE=iOS Club of XAUAT

# 多个反向代理 IP 使用英文逗号分隔。
TRUSTED_PROXY_IPS=

# 首次部署时自动创建 Founder（仅当 Staffs 表为空）。
# 生产环境必须显式提供，且不会回退到任何固定学号或默认密码。
# 学号必须 10 位数字；初始密码至少 12 位，且同时包含字母和数字。
# 创建后请立即登录并修改密码，或由运维用随机值管理。
FOUNDER_USER_ID=
FOUNDER_INIT_PASSWORD=
FOUNDER_NAME=root
