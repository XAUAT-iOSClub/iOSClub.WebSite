# 留空时使用持久化 SQLite；生产环境建议填写 PostgreSQL 连接字符串。
SQL=
REDIS=

# JWT 与管理端密钥等生产配置，请按需补充。
JWT_ISSUER=iOS Club of XAUAT
JWT_AUDIENCE=iOS Club of XAUAT

# 多个反向代理 IP 使用英文逗号分隔。
TRUSTED_PROXY_IPS=

# 首次部署时自动创建 Founder（仅当 Staffs 表为空）。
# 生产环境必须显式提供，且不会回退到任何固定学号或默认密码。
# 学号必须 10 位数字；初始密码至少 12 位，且同时包含字母和数字。
# 创建后请立即登录并修改密码，或由运维用随机值管理。
FOUNDER_USER_ID=
FOUNDER_INIT_PASSWORD=
FOUNDER_NAME=root
