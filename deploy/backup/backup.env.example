# iOSClub 数据库备份执行器配置示例（不要提交真实凭据）
# 复制到 /etc/iosclub-backup/backup.env 并 chmod 600。
# 该文件只给 systemd 备份服务使用，WebAPI 不应读取这里的写凭据。

# ── PostgreSQL（使用只读备份账号） ─────────────────────────────
PGHOST=db.example.com
PGPORT=5432
PGDATABASE=iosclub
PGUSER=iosclub_backup
# 密码写在单独的 pgpass 文件中，权限 600：
#   host:port:database:user:password
PGPASSFILE=/etc/iosclub-backup/pgpass
PGCONNECT_TIMEOUT=10
# 托管数据库如无正确 TLS 证书，按其文档配置，不要随意改为 disable。
PGSSLMODE=verify-full

# ── 本地工作目录与保留 ────────────────────────────────────────
BACKUP_DIR=/var/backups/iosclub
BACKUP_LOCAL_RETENTION_DAYS=3
BACKUP_MIN_FREE_SPACE_MB=2048

# 自动备份周期（天）。定时器每日检查，只有距离上次成功超过该天数才真正备份。
BACKUP_INTERVAL_DAYS=30
# 手动立即备份时设置 BACKUP_FORCE=1 可跳过周期判断（测试/临时备份用）。
# BACKUP_FORCE=1

# ── Cloudflare R2（备份执行器写入凭据） ───────────────────────
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=iosclub-private-backups
R2_PREFIX=backups/postgresql/
R2_LATEST_MANIFEST_KEY=metadata/latest.json

# 仅授予该 Bucket 的上传/写入权限，不要使用账户全局凭据。
AWS_ACCESS_KEY_ID=<R2_WRITE_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<R2_WRITE_SECRET_ACCESS_KEY>

# ── WebAPI 侧（不要写在这个文件里） ───────────────────────────
# WebAPI 需要单独配置只读凭据与功能开关，例如通过平台的 Secret/环境变量：
#   BACKUP_FEATURE_ENABLED=true
#   R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   R2_REGION=auto
#   R2_BUCKET=iosclub-private-backups
#   R2_PREFIX=backups/postgresql/
#   R2_LATEST_MANIFEST_KEY=metadata/latest.json
#   BACKUP_DOWNLOAD_URL_EXPIRY_MINUTES=5
#   AWS_ACCESS_KEY_ID=<R2_READ_ONLY_ACCESS_KEY_ID>
#   AWS_SECRET_ACCESS_KEY=<R2_READ_ONLY_SECRET_ACCESS_KEY>
